{
  "purpose": "Full AutoPenTest validation blueprint",
  "model": "Prefer one vulnerability per service so each scanner can be verified against a known truth.",
  "base_target": "https://localhost:8443",
  "services": [
    {"name": "edge", "role": "reverse-proxy", "coverage": ["nmap", "ssl_scanner", "headers_scanner", "waf_scanner", "nikto"]},
    {"name": "app", "role": "web-app-core", "coverage": ["sql_injection", "xss_scanner", "auth_tester", "idor_scanner", "command_injection", "dir_traversal", "api_scanner", "cors_scanner", "ssrf_scanner"]},
    {"name": "uploads", "role": "directory-listing", "coverage": ["nikto", "headers_scanner"]},
    {"name": "admin", "role": "exposed-admin", "coverage": ["nikto", "auth_tester", "idor_scanner"]},
    {"name": "db", "role": "database", "coverage": ["nmap", "sql_injection", "secrets_scanner"]},
    {"name": "redis", "role": "cache", "coverage": ["nmap", "secrets_scanner"]},
    {"name": "aux-ui", "role": "client-side-vuln-app", "coverage": ["dom_xss_scanner", "ssti_scanner", "xxe_scanner", "ldap_scanner", "http_smuggling_scanner"]},
    {"name": "source-tree", "role": "repo-mounted-code", "coverage": ["semgrep_scanner", "npm_scanner"]},
    {"name": "leak-file", "role": "credential-dump", "coverage": ["hashcat_scanner"]},
    {"name": "dns-lab", "role": "dns-target", "coverage": ["dns_scanner"]},
    {"name": "exploit-lab", "role": "known-vuln-host", "coverage": ["metasploit_scanner", "nuclei_scanner", "zap_scanner", "sqlmap_scanner"]}
  ],
  "scanner_expectations": [
    {"scanner": "nmap", "target": "edge/db/redis", "expected": "service discovery and open ports only"},
    {"scanner": "nikto", "target": "edge/uploads/admin", "expected": "server tokens, directory listing, exposed static/admin content"},
    {"scanner": "ssl_scanner", "target": "edge:8443", "expected": "self-signed cert and baseline TLS warnings"},
    {"scanner": "headers_scanner", "target": "edge", "expected": "missing HSTS/CSP and other hardening headers"},
    {"scanner": "waf_scanner", "target": "edge", "expected": "no WAF detected"},
    {"scanner": "sql_injection", "target": "app", "expected": "login/search SQL injection"},
    {"scanner": "sqlmap_scanner", "target": "app", "expected": "confirmed injectable parameters"},
    {"scanner": "xss_scanner", "target": "app", "expected": "reflected and stored XSS"},
    {"scanner": "dom_xss_scanner", "target": "aux-ui", "expected": "DOM sink reachable via client-side payload"},
    {"scanner": "ssti_scanner", "target": "aux-ui", "expected": "server-side template injection sink"},
    {"scanner": "xxe_scanner", "target": "aux-ui", "expected": "XML parser accepts external entities"},
    {"scanner": "ldap_scanner", "target": "aux-ui", "expected": "LDAP injection in directory lookup"},
    {"scanner": "auth_tester", "target": "app/admin", "expected": "weak auth and lockout/rate-limit gaps"},
    {"scanner": "idor_scanner", "target": "app/admin/api", "expected": "cross-user object access"},
    {"scanner": "command_injection", "target": "app", "expected": "ping endpoint command injection"},
    {"scanner": "dir_traversal", "target": "app", "expected": "files endpoint traversal"},
    {"scanner": "api_scanner", "target": "app", "expected": "unauthenticated API and sensitive fields"},
    {"scanner": "cors_scanner", "target": "app", "expected": "no permissive CORS policy"},
    {"scanner": "ssrf_scanner", "target": "app", "expected": "URL fetcher can reach internal metadata-like endpoint"},
    {"scanner": "http_smuggling_scanner", "target": "edge", "expected": "request parsing mismatch only if intentionally added"},
    {"scanner": "secrets_scanner", "target": "source-tree/db", "expected": "hardcoded secrets or leaked credentials"},
    {"scanner": "semgrep_scanner", "target": "source-tree", "expected": "static insecure code patterns"},
    {"scanner": "npm_scanner", "target": "source-tree", "expected": "vulnerable dependency or lockfile issue"},
    {"scanner": "dns_scanner", "target": "dns-lab", "expected": "subdomain enumeration and misconfigured DNS"},
    {"scanner": "nuclei_scanner", "target": "exploit-lab", "expected": "template-based known vulnerability hits"},
    {"scanner": "zap_scanner", "target": "app/exploit-lab", "expected": "active scan findings line up with known issues"},
    {"scanner": "metasploit_scanner", "target": "exploit-lab", "expected": "exploit succeeds only on the deliberately vulnerable host"},
    {"scanner": "hashcat_scanner", "target": "leak-file", "expected": "weak hashes crack to known test passwords"}
  ]
}
